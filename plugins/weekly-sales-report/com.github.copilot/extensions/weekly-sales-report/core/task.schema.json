{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "作業の定義（task.json）の決まり",
  "description": "生成プラグインの作業ごとの部分を決めるファイル task.json の形。合否の基準は組み立てのスクリプトがナレッジの一覧から書く。作業エージェントは criteria を書かない。",
  "type": "object",
  "required": ["name", "maxIterationsDefault", "criteria", "workers", "settings", "displays"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "画面の題に出す作業の名前"
    },
    "maxIterationsDefault": {
      "type": "integer",
      "minimum": 1,
      "description": "開始前の設定の、繰り返しの上限の初めの値"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "description": "ユーザーと確かめた合否の基準。knowledge は、もとになった「合否の決め方」のナレッジの番号",
      "items": {
        "type": "object",
        "required": ["id", "text", "knowledge"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^C-[0-9]+$", "description": "基準の番号（例：C-01）" },
          "text": { "type": "string", "minLength": 1, "description": "基準の文。ナレッジの文のまま書く" },
          "knowledge": { "type": "string", "pattern": "^K-[0-9]+$", "description": "もとになったナレッジの番号（K- に数字を続けた形）" }
        }
      }
    },
    "workers": {
      "type": "array",
      "minItems": 1,
      "description": "作業エージェント。agent は com.github.copilot/agents/ のファイル名から .agent.md を除いたもの",
      "items": {
        "type": "object",
        "required": ["agent", "label"],
        "additionalProperties": false,
        "properties": {
          "agent": { "type": "string", "pattern": "^worker(-[a-z0-9]+)*$", "description": "worker、または worker-<名前>" },
          "label": { "type": "string", "minLength": 1, "description": "画面での呼び名" }
        }
      }
    },
    "settings": {
      "type": "array",
      "description": "開始前の設定の部品",
      "items": {
        "type": "object",
        "required": ["key", "label", "type"],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
            "not": { "enum": ["maxIterations"], "description": "画面の「繰り返しの上限」の欄の番号なので使えない。使うと同じ id の欄が2つになる" },
            "description": "設定の番号（英数字と _）"
          },
          "label": { "type": "string", "minLength": 1, "description": "画面の見出し" },
          "type": { "enum": ["text", "number", "select", "checkbox", "path"], "description": "部品の種類" },
          "default": { "description": "初めの値。text と path は文字、number は数、checkbox は真偽、select は選択肢のどれか" },
          "required": { "type": "boolean", "description": "必須か" },
          "help": { "type": "string", "description": "説明" },
          "options": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true,
            "description": "select の選択肢"
          }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "enum": ["text", "path"] } }, "required": ["type"] },
            "then": { "properties": { "default": { "type": "string" } } }
          },
          {
            "if": { "properties": { "type": { "const": "number" } }, "required": ["type"] },
            "then": { "properties": { "default": { "type": "number" } } }
          },
          {
            "if": { "properties": { "type": { "const": "checkbox" } }, "required": ["type"] },
            "then": { "properties": { "default": { "type": "boolean" } } }
          },
          {
            "if": { "properties": { "type": { "const": "select" } }, "required": ["type"] },
            "then": {
              "required": ["options"],
              "properties": { "default": { "type": "string" }, "options": { "minItems": 1 } }
            }
          }
        ]
      }
    },
    "displays": {
      "type": "array",
      "description": "実行中と終わった後の表示の部品",
      "items": {
        "type": "object",
        "required": ["key", "label", "type", "when"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$", "description": "表示の番号（英数字と _）" },
          "label": { "type": "string", "minLength": 1, "description": "画面の見出し" },
          "type": { "enum": ["kv", "table", "progress", "text", "image", "file"], "description": "部品の種類" },
          "when": { "enum": ["running", "finished", "both"], "description": "いつ見せるか" }
        }
      }
    }
  }
}
