{
  "name": "自律型組み込み機器デバッグ",
  "maxIterationsDefault": 3,
  "criteria": [
    {
      "id": "C-01",
      "text": "ログ追加・クロスコンパイル・デプロイのような機器ごとに異なる処理は、ユーザーがAIが判断するためのルールをスキルとして作成・カスタマイズでき、AIはそのルールに基づいて自律的に推論・実行する。Makefile、バッチファイル、複数段階ビルド、TFTP、CRCやサム値の調整は具体例であり固定仕様ではない。",
      "knowledge": "K-07"
    },
    {
      "id": "C-02",
      "text": "デバッグの成功条件は人間と会話しながら決める。初期プロンプトに成功条件が書いてあればそれを達成した時に成功としてループを終える。書いてなければ、調査を始める前にプラグインから人間に成功条件を質問する。",
      "knowledge": "K-13"
    },
    {
      "id": "C-03",
      "text": "プラグインとして固定の禁止事項はない。守らないと困ることがあればユーザーが初期プロンプトで伝えるので、AIは初期プロンプトに書かれた制約を全イテレーションで守る。",
      "knowledge": "K-14"
    }
  ],
  "workers": [
    {
      "agent": "worker",
      "label": "ソースコード担当"
    },
    {
      "agent": "worker-b",
      "label": "ビルド・デプロイ担当"
    }
  ],
  "settings": [
    {
      "key": "device_ip",
      "label": "組み込み機器のIPアドレス",
      "type": "text",
      "required": false
    },
    {
      "key": "device_info",
      "label": "組み込み機器のその他の情報（接続方法、ログイン、転送先など）",
      "type": "text",
      "required": false
    },
    {
      "key": "source_dir",
      "label": "ローカルPC上のソースコードの場所",
      "type": "path",
      "required": true
    },
    {
      "key": "cross_compile_info",
      "label": "クロスコンパイルに必要な情報（ツールチェーンや環境セットアップのファイルの場所など）",
      "type": "text",
      "required": false
    },
    {
      "key": "effort_orchestrator",
      "label": "まとめ役の AI のエフォートレベル",
      "type": "select",
      "options": [
        "既定のまま",
        "low",
        "medium",
        "high"
      ],
      "default": "既定のまま",
      "required": false,
      "help": "作業を始めるとき、この値でカスタムエージェントのフロントマターの reasoningEffort を書き換える（既定のままなら行を消す）"
    },
    {
      "key": "effort_worker",
      "label": "ソースコード担当のエフォートレベル",
      "type": "select",
      "options": [
        "既定のまま",
        "low",
        "medium",
        "high"
      ],
      "default": "既定のまま",
      "required": false,
      "help": "作業を始めるとき、この値でカスタムエージェントのフロントマターの reasoningEffort を書き換える（既定のままなら行を消す）"
    },
    {
      "key": "effort_worker_b",
      "label": "ビルド・デプロイ担当のエフォートレベル",
      "type": "select",
      "options": [
        "既定のまま",
        "low",
        "medium",
        "high"
      ],
      "default": "既定のまま",
      "required": false,
      "help": "作業を始めるとき、この値でカスタムエージェントのフロントマターの reasoningEffort を書き換える（既定のままなら行を消す）"
    },
    {
      "key": "effort_verifier",
      "label": "確認役の AI のエフォートレベル",
      "type": "select",
      "options": [
        "既定のまま",
        "low",
        "medium",
        "high"
      ],
      "default": "既定のまま",
      "required": false,
      "help": "作業を始めるとき、この値でカスタムエージェントのフロントマターの reasoningEffort を書き換える（既定のままなら行を消す）"
    }
  ],
  "displays": [
    {
      "key": "conclusion",
      "label": "結論",
      "type": "text",
      "when": "finished"
    },
    {
